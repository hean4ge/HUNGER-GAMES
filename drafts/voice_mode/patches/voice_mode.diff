diff --git a/src/ServerScriptService/Server/Services/VoiceService/Routing.lua b/src/ServerScriptService/Server/Services/VoiceService/Routing.lua
new file mode 100644
index 0000000000000000000000000000000000000000..a4fd9e53d9999c4906ee4fe5b27a8a4515e8346e
--- /dev/null
+++ b/src/ServerScriptService/Server/Services/VoiceService/Routing.lua
@@ -0,0 +1,154 @@
+--[[
+	Routing - Proximity Voice's server rules as pure functions (docs/design/VoiceMode.md). No services, no instances:
+	VoiceService feeds it plain tables and runs the writes it plans; ServerStorage.Dev.VoiceRoutingTest checks every rule
+	in Edit mode, and voice_mode/_tools/routing_model.py model-checks plan() exhaustively.
+
+	A device state is { muted: boolean, allow: boolean, list: { number } } (list sorted, UserIds):
+	  allow = false (AccessType Deny): everyone except the list may hear the device; we only ever use an empty list.
+	  allow = true  (AccessType Allow): only the list may hear it.
+	  muted = true: nobody hears it.
+
+	  Routing.assign(roster, running) -> (roles, bench)
+	      roster = { { key: any, id: number, alive: boolean } }; roles[key] = "Open" | "Contender" | "Bench";
+	      bench = the sorted UserIds of every Bench player (the stands: the fallen, late joiners, the lobby)
+	  Routing.choice(st, defaultOn) -> boolean?
+	      st = { explicit: boolean?, saved: boolean?, loadState: "Loading" | "Loaded" | "Failed" }
+	      The player's Proximity voice choice. nil = not known yet: the player stays muted, however long that takes.
+	      There is no time limit after which it turns on by itself.
+	  Routing.desired(role, on, whisper, allies, bench, serverMode) -> state
+	  Routing.plan(current, target) -> { { op: "Muted" | "AccessType" | "List", value: any } }
+	      The writes that take a device from current to target. No intermediate state lets anyone hear the player who
+	      isn't allowed to both before and after the switch: mute first, unmute last; when narrowing to an allow list,
+	      the type goes before the list; when opening up, the list is emptied before the type.
+	  Routing.audience(state, everyone) -> { [number]: true }   who could hear a device in that state (tests)
+	  Routing.exempt(action, value) -> boolean   requests that are never rate-limited or dropped: SetVoice(false)
+	  Routing.sameList(a, b) -> boolean    Routing.sortedIds(list) -> { number }
+]]
+local Routing = {}
+
+function Routing.sortedIds(list: { any }?): { number }
+	local out = {}
+	if type(list) == "table" then
+		for _, value in ipairs(list) do
+			local id = tonumber(value)
+			if id then
+				table.insert(out, id)
+			end
+		end
+	end
+	table.sort(out)
+	return out
+end
+
+function Routing.sameList(a: { number }, b: { number }): boolean
+	if #a ~= #b then
+		return false
+	end
+	for i = 1, #a do
+		if a[i] ~= b[i] then
+			return false
+		end
+	end
+	return true
+end
+
+function Routing.role(running: boolean, alive: boolean): string
+	if not running then
+		return "Open"
+	end
+	return if alive then "Contender" else "Bench"
+end
+
+function Routing.assign(roster: { { [string]: any } }, running: boolean): ({ [any]: string }, { number })
+	local roles = {}
+	local bench = {}
+	for _, entry in ipairs(roster) do
+		local role = Routing.role(running, entry.alive == true)
+		roles[entry.key] = role
+		if role == "Bench" then
+			table.insert(bench, entry.id) -- listeners: everyone on the bench, with or without a microphone
+		end
+	end
+	table.sort(bench)
+	return roles, bench
+end
+
+function Routing.choice(st: { [string]: any }, defaultOn: boolean): boolean?
+	if st.explicit ~= nil then
+		return st.explicit == true -- chosen this session: newer than any saved copy
+	end
+	if st.loadState == "Loaded" then
+		if st.saved ~= nil then
+			return st.saved == true
+		end
+		return defaultOn -- loaded, never chosen
+	end
+	return nil -- still loading, or the load failed: unknown, so muted until the player chooses
+end
+
+function Routing.desired(role: string, on: boolean?, whisper: boolean, allies: { number }, bench: { number },
+	serverMode: string): { [string]: any }
+	local muted = serverMode == "Off" or on ~= true
+	if role == "Bench" then
+		return { muted = muted, allow = true, list = table.clone(bench) }
+	end
+	if role == "Contender" and whisper and #allies > 0 then
+		return { muted = muted, allow = true, list = table.clone(allies) }
+	end
+	return { muted = muted, allow = false, list = {} }
+end
+
+function Routing.plan(current: { [string]: any }, target: { [string]: any }): { { [string]: any } }
+	local steps = {}
+	local tempMuted = false
+	if target.muted and not current.muted then
+		table.insert(steps, { op = "Muted", value = true })
+	end
+	if target.allow then
+		if not current.allow then
+			if #current.list > 0 and not target.muted and not current.muted then
+				-- Allow with a deny list that isn't empty would let exactly the excluded players in: mute for the switch
+				table.insert(steps, { op = "Muted", value = true })
+				tempMuted = true
+			end
+			table.insert(steps, { op = "AccessType", value = "Allow" })
+		end
+		if not Routing.sameList(current.list, target.list) then
+			table.insert(steps, { op = "List", value = table.clone(target.list) })
+		end
+	else
+		if #current.list > 0 then
+			table.insert(steps, { op = "List", value = {} }) -- with Allow: nobody; with Deny: widening to the target anyway
+		end
+		if current.allow then
+			table.insert(steps, { op = "AccessType", value = "Deny" })
+		end
+	end
+	if not target.muted and (current.muted or tempMuted) then
+		table.insert(steps, { op = "Muted", value = false })
+	end
+	return steps
+end
+
+function Routing.audience(state: { [string]: any }, everyone: { number }): { [number]: boolean }
+	local out = {}
+	if state.muted then
+		return out
+	end
+	local listed = {}
+	for _, id in ipairs(state.list) do
+		listed[id] = true
+	end
+	for _, id in ipairs(everyone) do
+		if (state.allow and listed[id]) or (not state.allow and not listed[id]) then
+			out[id] = true
+		end
+	end
+	return out
+end
+
+function Routing.exempt(action: any, value: any): boolean
+	return action == "SetVoice" and value == false
+end
+
+return Routing
diff --git a/src/ServerScriptService/Server/Services/VoiceService/VoiceServers.lua b/src/ServerScriptService/Server/Services/VoiceService/VoiceServers.lua
new file mode 100644
index 0000000000000000000000000000000000000000..e3f6932e86dad37bf46a160ff4647981f5001cfe
--- /dev/null
+++ b/src/ServerScriptService/Server/Services/VoiceService/VoiceServers.lua
@@ -0,0 +1,312 @@
+--[[
+	VoiceServers - Proximity Voice, phase 2: voice-only servers (docs/design/VoiceMode.md, "Phase 2"). VoiceService loads it
+	only when Config.Voice.VoiceServers.Enabled is true. Off for the beta: one pool of players fills 24-contender rounds
+	faster, and Roblox's matchmaking already groups voice users (its Voice Chat signal).
+
+	  * Joining (in a public server's lobby, VOICE-ONLY SERVER on the lobby card -> VoiceRequest "JoinVoiceServer"): the
+	    server checks the player can use voice (VoiceChatService:IsVoiceEnabledForUserIdAsync) and isn't in a round, picks
+	    the voice-only server with room that starts soonest and is fullest (the MemoryStore sorted map VoiceServers_v1)
+	    or opens a new one (a GUID ticket in the MemoryStore hash map VoiceTickets_v1), and teleports the player there
+	    with TeleportOptions.ReservedServerId = that GUID.
+	  * A voice-only server (a reserved server whose ticket says VoiceOnly) returns "VoiceOnly" from resolve() (VoiceService
+	    publishes GameState.VoiceMode), advertises { count, max, phase, t } every AdvertiseInterval seconds, and sends anyone
+	    without voice back to the public servers with a toast.
+	  * Leaving (LEAVE VOICE-ONLY SERVER on the lobby card -> "LeaveVoiceServer"): a plain TeleportAsync to this place,
+	    which is Roblox matchmaking.
+	Teleport data is only a pointer to the ticket; the ticket in MemoryStore is the authority (modes-progression.md 4.3).
+	MemoryStore and reserved servers work only in a published game (TeleportAsync also runs in Team Test).
+	API: init(VoiceService)   resolve() -> "VoiceOnly"? (yields)   onPlayerAdded(player)   request(player, action)
+	     isVoiceServer() -> boolean
+]]
+local HttpService = game:GetService("HttpService")
+local MemoryStoreService = game:GetService("MemoryStoreService")
+local Players = game:GetService("Players")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+local TeleportService = game:GetService("TeleportService")
+local VoiceChatService = game:GetService("VoiceChatService")
+
+local Shared = ReplicatedStorage:WaitForChild("Shared")
+local Config = require(Shared:WaitForChild("Config"))
+local Net = require(Shared:WaitForChild("Net"))
+
+local GameState = ReplicatedStorage:WaitForChild("GameState")
+local Cfg = (Config.Voice and Config.Voice.VoiceServers) or {}
+
+local SERVERS_MAP = "VoiceServers_v1"
+local TICKETS_MAP = "VoiceTickets_v1"
+local TICKET_TTL = 6 * 60 * 60 -- seconds; a running voice server refreshes its own ticket every 10 minutes
+local ADVERT_TTL = 60
+local STALE_AFTER = 45 -- an advert older than this belongs to a server that has gone
+local PHASE_RANK = { Lobby = 3, Intermission = 2, Ending = 1 } -- where a joiner gets into a round soonest
+
+local VoiceServers = {}
+local voiceServer = false
+local matchId: string? = nil
+local busy: { [Player]: boolean } = {}
+local gated: { [Player]: boolean } = {}
+local lastTicketWrite = -math.huge
+
+local function maxPlayers(): number
+	return math.max(2, math.floor(tonumber(Cfg.MaxPlayers) or 24))
+end
+
+local function notify(player: Player, text: string, sub: string?)
+	pcall(function()
+		Net.event("Announce"):FireClient(player, { style = "Toast", text = text, sub = sub, duration = 4 })
+	end)
+end
+
+-- true / false, or nil when Roblox couldn't say (an HTTP error)
+local function voiceEnabled(player: Player): boolean?
+	local ok, result = pcall(function()
+		return VoiceChatService:IsVoiceEnabledForUserIdAsync(player.UserId)
+	end)
+	if not ok then
+		return nil
+	end
+	return result == true
+end
+
+local function readTicket(id: string): { [string]: any }?
+	local ok, value = pcall(function()
+		return MemoryStoreService:GetHashMap(TICKETS_MAP):GetAsync(id)
+	end)
+	return if ok and type(value) == "table" then value else nil
+end
+
+local function writeTicket(id: string): boolean
+	local ok = pcall(function()
+		MemoryStoreService:GetHashMap(TICKETS_MAP):SetAsync(id, { mode = "VoiceOnly", t = os.time() }, TICKET_TTL)
+	end)
+	return ok
+end
+
+-- Teleports ----------------------------------------------------------------------------------------------------------
+
+local function teleportTo(player: Player, id: string): boolean
+	local options = Instance.new("TeleportOptions")
+	local okId, err = pcall(function()
+		(options :: any).ReservedServerId = id -- the GUID names the server: the first teleport creates it
+	end)
+	if not okId then
+		warn("[VoiceServers] TeleportOptions.ReservedServerId is unavailable: " .. tostring(err))
+		return false
+	end
+	options:SetTeleportData({ voiceMatch = id })
+	for attempt = 1, 3 do
+		local ok, result = pcall(function()
+			return TeleportService:TeleportAsync(game.PlaceId, { player }, options)
+		end)
+		if ok then
+			return true
+		end
+		warn(string.format("[VoiceServers] Teleport attempt %d failed: %s", attempt, tostring(result)))
+		task.wait(2 * attempt)
+		if player.Parent ~= Players then
+			return false
+		end
+	end
+	return false
+end
+
+-- Back to the public servers: no options means Roblox matchmaking picks one.
+local function toPublic(player: Player): boolean
+	for attempt = 1, 3 do
+		local ok, result = pcall(function()
+			return TeleportService:TeleportAsync(game.PlaceId, { player })
+		end)
+		if ok then
+			return true
+		end
+		warn(string.format("[VoiceServers] Return attempt %d failed: %s", attempt, tostring(result)))
+		task.wait(2 * attempt)
+		if player.Parent ~= Players then
+			return false
+		end
+	end
+	return false
+end
+
+-- Matching -----------------------------------------------------------------------------------------------------------
+
+local function pickServer(): string?
+	local ok, items = pcall(function()
+		return MemoryStoreService:GetSortedMap(SERVERS_MAP):GetRangeAsync(Enum.SortDirection.Descending, 50)
+	end)
+	if not ok or type(items) ~= "table" then
+		return nil
+	end
+	local now = os.time()
+	local best, bestScore = nil, -math.huge
+	for _, item in ipairs(items) do
+		local value = item.value
+		if type(item.key) == "string" and type(value) == "table" then
+			local count = tonumber(value.count) or 0
+			local max = tonumber(value.max) or maxPlayers()
+			local fresh = now - (tonumber(value.t) or 0) < STALE_AFTER
+			if fresh and count < max - 1 then -- leave a seat for a party member who follows
+				local score = (PHASE_RANK[value.phase] or 0) * 1000 + count
+				if score > bestScore then
+					best, bestScore = item.key, score
+				end
+			end
+		end
+	end
+	return best
+end
+
+-- In a voice-only server: tell the public servers we're here and how full we are.
+local function advertise()
+	local id = matchId
+	if not id then
+		return
+	end
+	local count = #Players:GetPlayers()
+	pcall(function()
+		MemoryStoreService:GetSortedMap(SERVERS_MAP):SetAsync(id, {
+			count = count,
+			max = maxPlayers(),
+			phase = GameState:GetAttribute("Phase") or "Lobby",
+			t = os.time(),
+		}, ADVERT_TTL, count)
+	end)
+	if os.clock() - lastTicketWrite > 600 then
+		lastTicketWrite = os.clock()
+		writeTicket(id)
+	end
+end
+
+local function unadvertise()
+	local id = matchId
+	if id then
+		pcall(function()
+			MemoryStoreService:GetSortedMap(SERVERS_MAP):RemoveAsync(id)
+		end)
+	end
+end
+
+-- Public API ---------------------------------------------------------------------------------------------------------
+
+function VoiceServers.isVoiceServer(): boolean
+	return voiceServer
+end
+
+-- On a reserved server: is it voice-only? Yields for MemoryStore (and up to 30 s for the first arrival).
+function VoiceServers.resolve(): string?
+	if game.PrivateServerId == "" or game.PrivateServerOwnerId ~= 0 then
+		return nil -- a public server, or a Roblox private server (Private Games)
+	end
+	local id = game.PrivateServerId
+	local ticket = readTicket(id)
+	if not ticket then
+		-- the ticket's GUID may not equal PrivateServerId: follow the first arrival's pointer, then check it in MemoryStore
+		local first = Players:GetPlayers()[1]
+		local deadline = os.clock() + 30
+		while not first and os.clock() < deadline do
+			task.wait(0.5)
+			first = Players:GetPlayers()[1]
+		end
+		if first then
+			local okJoin, joinData = pcall(function()
+				return first:GetJoinData()
+			end)
+			local data = if okJoin and type(joinData) == "table" then joinData.TeleportData else nil
+			local pointer = if type(data) == "table" then data.voiceMatch else nil
+			if type(pointer) == "string" and #pointer <= 64 then
+				ticket = readTicket(pointer)
+				if ticket then
+					id = pointer
+				end
+			end
+		end
+	end
+	if not (ticket and ticket.mode == "VoiceOnly") then
+		return nil
+	end
+	voiceServer = true
+	matchId = id
+	game:BindToClose(unadvertise)
+	task.spawn(function()
+		while true do
+			advertise()
+			task.wait(math.max(5, tonumber(Cfg.AdvertiseInterval) or 15))
+		end
+	end)
+	for _, player in ipairs(Players:GetPlayers()) do
+		task.spawn(VoiceServers.onPlayerAdded, player)
+	end
+	return "VoiceOnly"
+end
+
+-- On a voice-only server: anyone Roblox says can't use voice goes back to the public servers.
+function VoiceServers.onPlayerAdded(player: Player)
+	if not voiceServer or gated[player] then
+		return
+	end
+	gated[player] = true
+	if voiceEnabled(player) == false and player.Parent == Players then
+		notify(player, "THIS IS A VOICE-ONLY SERVER", "Voice isn't on for your account · taking you to a regular server")
+		task.wait(3)
+		if player.Parent == Players then
+			toPublic(player)
+		end
+	end
+end
+
+function VoiceServers.request(player: Player, action: string)
+	if busy[player] then
+		return
+	end
+	busy[player] = true
+	local ok, err = pcall(function()
+		if action == "LeaveVoiceServer" then
+			if voiceServer then
+				notify(player, "LEAVING THE VOICE-ONLY SERVER", "Taking you to a regular server")
+				toPublic(player)
+			end
+			return
+		end
+		if voiceServer then
+			return -- already on one
+		end
+		if player:GetAttribute("Alive") == true or player:GetAttribute("InArena") == true then
+			notify(player, "FINISH YOUR ROUND FIRST", "Voice-only servers open from the lobby")
+			return
+		end
+		if voiceEnabled(player) ~= true then
+			notify(player, "VOICE ISN'T ON FOR YOUR ACCOUNT", "Voice-only servers need Roblox voice chat")
+			return
+		end
+		local id = pickServer()
+		if not id then
+			id = HttpService:GenerateGUID(false)
+			if not writeTicket(id) then
+				notify(player, "COULDN'T OPEN A VOICE-ONLY SERVER", "Try again in a moment")
+				return
+			end
+		end
+		notify(player, "VOICE-ONLY SERVER", "Taking you there…")
+		if not teleportTo(player, id :: string) then
+			notify(player, "TELEPORT FAILED", "You're still here · try again in a moment")
+		end
+	end)
+	busy[player] = nil
+	if not ok then
+		warn("[VoiceServers] " .. tostring(err))
+	end
+end
+
+function VoiceServers.init(_voiceService)
+	TeleportService.TeleportInitFailed:Connect(function(player: Player, result, message)
+		if player and player.Parent == Players then
+			warn(string.format("[VoiceServers] Teleport failed for %s: %s %s", player.Name, tostring(result), tostring(message)))
+			notify(player, "TELEPORT FAILED", "You're still here · try again in a moment")
+		end
+	end)
+	Players.PlayerRemoving:Connect(function(player)
+		busy[player] = nil
+		gated[player] = nil
+	end)
+end
+
+return VoiceServers
diff --git a/src/ServerScriptService/Server/Services/VoiceService/init.lua b/src/ServerScriptService/Server/Services/VoiceService/init.lua
new file mode 100644
index 0000000000000000000000000000000000000000..b0ad7f88de0deede20fe0af640306da87342700c
--- /dev/null
+++ b/src/ServerScriptService/Server/Services/VoiceService/init.lua
@@ -0,0 +1,607 @@
+--[[
+	VoiceService - Proximity Voice, server side: who can hear whom (docs/design/VoiceMode.md). Behind Config.Voice.Enabled:
+	while that is false this service does nothing. (Roblox's own voice still runs: how it sounds then depends on the
+	place's VoiceChatService settings, not on this flag. See studio/ApplyVoiceSettings.lua.)
+
+	With VoiceChatService.UseAudioApi = Enabled and EnableDefaultVoice = true, Roblox gives every voice-eligible player an
+	AudioDeviceInput under their Player. This service writes three things on each of those devices, on the server (the
+	access list is set on the server and replicates to clients):
+	  * AccessType + SetUserIdAccessList, from the player's voice role (Player attribute VoiceRole):
+	      "Open"       no round running (Lobby, Intermission, Ending): Deny + an empty list = anyone in range hears them.
+	      "Contender"  alive in a running round: anyone in range (other contenders, and spectators watching close by).
+	                   While whispering (Config.Voice.Whisper, truce allies): Allow + those allies only.
+	      "Bench"      everyone else while a round runs (the fallen, late joiners, the lobby: "the stands"): Allow + the
+	                   bench's UserIds. The living are never on that list, wherever their body or their camera is.
+	  * Muted, unless the player's choice is known and On (Routing.choice): their choice this session (VoiceRequest
+	    SetVoice), else their saved one once DataService says the profile loaded (SettingsLoaded = true). Until then, and
+	    for the whole session if the load failed, they stay muted: nothing turns a saved OFF back on by itself.
+	    ServerMode "Off" mutes everyone. Roblox's own mic toggle (AudioDeviceInput.Active) is never touched.
+	A contender who falls moves to the bench the moment PlayerService handles the death (onEliminated), before the cannon.
+	Every pass reads each device back and rewrites whatever differs from the rules, in Routing.plan's fail-closed order;
+	a write that fails is retried on the next pass (at most 5 s later), and a device someone else changed is logged.
+	What this does not prove: where Roblox applies the list (the docs don't say whether a modified client could still
+	receive a stream it isn't listed for), and whether Roblox's own mute, block and volume controls reach the client's
+	custom audio chain. Those are the published safety gate (VoiceMode.md, test plan G1-G6).
+	It never records: no AudioRecorder, no speech-to-text, no audio analysis on the server.
+
+	Attributes (replicated):
+	  GameState.VoiceMode   "Proximity" | "Off" | "VoiceOnly" (a voice-only server, VoiceServers); not set while disabled
+	  Player.VoiceRole      "Open" | "Contender" | "Bench"
+	  Player.VoiceOn        true while the server lets this player be heard (the device is unmuted)
+	  Player.VoiceHold      "" | "Loading" (the saved choice is still loading) | "NotLoaded" (it couldn't load): why a
+	                        player who hasn't chosen this session is muted
+	  Player.VoiceWhisper   true while this player whispers to allies (clients shorten that voice's reach)
+	  Player.VoiceAllies    how many allies would hear a whisper (0 = nothing to whisper to)
+	  (Player.Spectating is written by PlayerService; Player.SettingsLoaded by DataService)
+	API (through the registry):
+	  VoiceService.isEnabled() -> boolean
+	  VoiceService.getRole(player) -> string
+	  VoiceService.onEliminated(player)            PlayerService.handleDeath, right after the victim's Alive goes false
+	  VoiceService.refresh()                       recompute and re-check every device now
+	  VoiceService.setAllies(player, { Player })   for a future TruceService (Config.Voice.Whisper)
+	  VoiceService.changed: Signal()               after every pass
+	  VoiceService.debugState() -> { [string]: any }
+	Remote VoiceRequest(action: string, value: any), validated; each action has its own rate limit, and a request over
+	the limit is applied shortly instead of dropped (the last one always lands). SetVoice(false) is never limited.
+	  "SetVoice" (boolean)   the player's explicit Proximity voice choice (the client sends it only when they toggle it)
+	  "Whisper"  (boolean)   hold to whisper; ignored unless Config.Voice.Whisper.Enabled and the player has allies
+	  "JoinVoiceServer" / "LeaveVoiceServer"   phase 2: VoiceServers (Config.Voice.VoiceServers.Enabled)
+]]
+local HttpService = game:GetService("HttpService")
+local Players = game:GetService("Players")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+local VoiceChatService = game:GetService("VoiceChatService")
+
+local Shared = ReplicatedStorage:WaitForChild("Shared")
+local Config = require(Shared:WaitForChild("Config"))
+local Net = require(Shared:WaitForChild("Net"))
+local Signal = require(Shared:WaitForChild("Signal"))
+
+-- (a timeout, so a missing child makes this one service fail to load instead of stalling the server's loader)
+local Routing = require(script:WaitForChild("Routing", 10))
+
+local GameState = ReplicatedStorage:WaitForChild("GameState")
+local VoiceCfg = Config.Voice or {}
+
+local SAFETY_INTERVAL = 5 -- seconds between full re-checks (each reads every device back; unchanged ones aren't written)
+local NO_DEVICE_WARNING = 30 -- seconds a voice-enabled player may go without a device before we say why
+local FLUSH_DELAY = 0.5 -- seconds before a request that was over the rate limit is applied
+local DEFAULT_ROUND_PHASES = { Countdown = true, Active = true }
+
+-- Enum.AccessModifierType (Allow / Deny) comes with the Audio API; without it there is nothing to route
+local ALLOW: EnumItem? = nil
+local DENY: EnumItem? = nil
+pcall(function()
+	ALLOW = (Enum :: any).AccessModifierType.Allow
+	DENY = (Enum :: any).AccessModifierType.Deny
+end)
+
+local VoiceService = {}
+VoiceService.changed = Signal.new()
+
+local Services = nil
+local enabled = false
+local serverMode = "Proximity" -- "Proximity" | "Off" | "VoiceOnly"
+local states = {} -- [Player] = per-player state (newState)
+local queued = false
+local warned = {}
+local VoiceServers = nil -- the phase-2 module, when Config.Voice.VoiceServers.Enabled
+
+-- Helpers ----------------------------------------------------------------------------------------------------------
+
+local function warnOnce(key: string, message: string)
+	if warned[key] then
+		return
+	end
+	warned[key] = true
+	warn("[VoiceService] " .. message)
+end
+
+local function debugPrint(...: any)
+	if VoiceCfg.Debug == true then
+		print("[VoiceService]", ...)
+	end
+end
+
+local function setAttr(player: Player, name: string, value: any)
+	if player:GetAttribute(name) ~= value then
+		player:SetAttribute(name, value)
+	end
+end
+
+local function newState()
+	return {
+		device = nil :: AudioDeviceInput?,
+		explicit = nil :: boolean?, -- the player's choice this session (SetVoice): newer than any saved copy
+		saved = nil :: boolean?, -- the saved choice (SettingsJson voiceOn), read only once the profile has loaded
+		loadState = "Loading", -- "Loading" | "Loaded" | "Failed" (DataService's SettingsLoaded attribute)
+		whisper = false,
+		allies = {} :: { [Player]: boolean },
+		role = "Open",
+		lastTarget = nil :: { [string]: any }?, -- what this service last wrote to the device (drift check)
+		failed = false, -- the last write failed: the next pass tries again
+		eligible = nil :: boolean?,
+		connections = {} :: { RBXScriptConnection },
+		pending = {} :: { [string]: { value: any } }, -- requests over the rate limit, applied shortly
+		flushQueued = false,
+	}
+end
+
+-- Roles ------------------------------------------------------------------------------------------------------------
+
+local function roundRunning(): boolean
+	local rs = Services and Services.RoundService
+	if rs and type(rs.isRoundRunning) == "function" then
+		local ok, running = pcall(rs.isRoundRunning)
+		if ok then
+			return running == true
+		end
+	end
+	local phases = VoiceCfg.RoundPhases or DEFAULT_ROUND_PHASES
+	return phases[GameState:GetAttribute("Phase")] == true
+end
+
+local function isAlive(player: Player): boolean
+	local ps = Services and Services.PlayerService
+	if ps and type(ps.isAlive) == "function" then
+		local ok, alive = pcall(ps.isAlive, player)
+		if ok then
+			return alive == true
+		end
+	end
+	return player:GetAttribute("Alive") == true
+end
+
+-- The saved choice ---------------------------------------------------------------------------------------------------
+
+-- DataService sets SettingsJson, then SettingsLoaded: true once the stored profile was read (or, in Studio only, when
+-- DataStores are off), false when the load failed. Only a loaded profile counts; "{}" after a failed load is not a
+-- choice. (The player's explicit choice this session, st.explicit, always wins over this.)
+local function readSaved(player: Player, st)
+	local loaded = player:GetAttribute("SettingsLoaded")
+	local json = player:GetAttribute("SettingsJson")
+	st.saved = nil
+	if loaded == false then
+		st.loadState = "Failed"
+		return
+	end
+	if loaded ~= true or type(json) ~= "string" or json == "" then
+		st.loadState = "Loading"
+		return
+	end
+	st.loadState = "Loaded"
+	local ok, decoded = pcall(HttpService.JSONDecode, HttpService, json)
+	if ok and type(decoded) == "table" and type(decoded.voiceOn) == "number" then
+		st.saved = decoded.voiceOn >= 0.5
+	end
+end
+
+-- Devices ----------------------------------------------------------------------------------------------------------
+
+local function findDevice(player: Player): AudioDeviceInput?
+	for _, child in ipairs(player:GetChildren()) do
+		if child:IsA("AudioDeviceInput") then
+			local owner = (child :: any).Player
+			if owner == nil or owner == player then
+				return child :: AudioDeviceInput
+			end
+		end
+	end
+	return nil
+end
+
+-- The device as it is now (nil if it can't be read: the next pass tries again)
+local function readDevice(device: AudioDeviceInput): { [string]: any }?
+	local ok, state = pcall(function()
+		return {
+			muted = device.Muted == true,
+			allow = device.AccessType == ALLOW,
+			list = Routing.sortedIds(device:GetUserIdAccessList()),
+		}
+	end)
+	return if ok then state else nil
+end
+
+local function runSteps(device: AudioDeviceInput, steps: { { [string]: any } })
+	for _, step in ipairs(steps) do
+		if step.op == "Muted" then
+			device.Muted = step.value == true
+		elseif step.op == "AccessType" then
+			device.AccessType = (if step.value == "Allow" then ALLOW else DENY) :: any
+		elseif step.op == "List" then
+			device:SetUserIdAccessList(step.value)
+		end
+	end
+end
+
+local function describe(state: { [string]: any }): string
+	return string.format("%s %s(%d)", if state.muted then "muted" else "live", if state.allow then "Allow" else "Deny", #state.list)
+end
+
+local function allyIds(player: Player, st): { number }
+	local ids = {}
+	for ally in pairs(st.allies) do
+		if ally.Parent == Players and ally ~= player then
+			table.insert(ids, ally.UserId)
+		end
+	end
+	table.sort(ids)
+	return ids
+end
+
+local function applyPlayer(player: Player, st, bench: { number })
+	local on = Routing.choice(st, VoiceCfg.DefaultOn ~= false)
+	local allies = allyIds(player, st)
+	local whisper = st.whisper and st.role == "Contender" and #allies > 0
+	local target = Routing.desired(st.role, on, whisper, allies, bench, serverMode)
+	local live = not target.muted
+	setAttr(player, "VoiceRole", st.role)
+	setAttr(player, "VoiceHold", if on ~= nil then "" elseif st.loadState == "Failed" then "NotLoaded" else "Loading")
+	setAttr(player, "VoiceWhisper", whisper)
+	setAttr(player, "VoiceAllies", if st.role == "Contender" then #allies else 0)
+	if not live then
+		setAttr(player, "VoiceOn", false) -- the client closes its mic on this at once (VoiceController)
+	end
+
+	local device = st.device
+	if not device or device.Parent ~= player then
+		setAttr(player, "VoiceOn", live)
+		return
+	end
+	local current = readDevice(device)
+	if not current then
+		st.failed = true
+		warnOnce("read:" .. player.UserId, "Couldn't read " .. player.Name .. "'s voice device; trying again.")
+		return
+	end
+	local last = st.lastTarget
+	if last and not st.failed and (current.muted ~= last.muted or current.allow ~= last.allow
+		or not Routing.sameList(current.list, last.list)) then
+		-- something other than this service changed the device: put it back, and say so once (worth knowing in tests)
+		warnOnce("drift:" .. player.UserId, string.format("%s's voice device changed under us (%s, expected %s); rewritten.",
+			player.Name, describe(current), describe(last)))
+	end
+	local steps = Routing.plan(current, target)
+	if #steps > 0 then
+		local ok, err = pcall(runSteps, device, steps)
+		if not ok then
+			st.failed = true
+			st.lastTarget = nil
+			warnOnce("write:" .. tostring(err), "Couldn't set a voice device: " .. tostring(err))
+			return
+		end
+		debugPrint(player.Name, st.role, describe(current), "->", describe(target))
+	end
+	st.failed = false
+	st.lastTarget = target
+	if live then
+		setAttr(player, "VoiceOn", true) -- only once the device really is open
+	end
+end
+
+-- Recompute every role, read every device back and write what differs.
+local function refreshNow()
+	queued = false
+	if not enabled then
+		return
+	end
+	local running = roundRunning()
+	local roster = {}
+	for player, st in pairs(states) do
+		if player.Parent == Players then
+			table.insert(roster, { key = player, id = player.UserId, alive = isAlive(player) })
+		end
+	end
+	local roles, bench = Routing.assign(roster, running)
+	for player, st in pairs(states) do
+		if player.Parent == Players then
+			st.role = roles[player] or "Open"
+			applyPlayer(player, st, bench)
+		end
+	end
+	VoiceService.changed:Fire()
+end
+
+local function safeRefresh()
+	local ok, err = pcall(refreshNow)
+	if not ok then
+		queued = false
+		warnOnce("refresh:" .. tostring(err), "Refresh failed: " .. tostring(err))
+	end
+end
+
+local function queueRefresh()
+	if queued or not enabled then
+		return
+	end
+	queued = true
+	task.defer(safeRefresh)
+end
+
+-- Players ----------------------------------------------------------------------------------------------------------
+
+-- Diagnostics only: a voice-enabled player without a device means the place still runs Roblox's old built-in voice.
+local function checkEligibility(player: Player, st)
+	local ok, result = pcall(function()
+		return VoiceChatService:IsVoiceEnabledForUserIdAsync(player.UserId)
+	end)
+	if not ok or states[player] ~= st then
+		return
+	end
+	st.eligible = result == true
+	if st.eligible then
+		task.delay(NO_DEVICE_WARNING, function()
+			if states[player] == st and player.Parent == Players and not st.device then
+				warnOnce("nodevice", string.format("A voice-enabled player still has no AudioDeviceInput after %d s. Is "
+					.. "VoiceChatService.UseAudioApi = Enabled in Studio? (Automatic still runs the old built-in voice, which "
+					.. "these rules can't reach.)", NO_DEVICE_WARNING))
+			end
+		end)
+	end
+end
+
+local function useDevice(player: Player, st)
+	local device = findDevice(player)
+	if device ~= st.device then
+		st.device = device
+		st.lastTarget = nil
+		st.failed = false
+		queueRefresh()
+	end
+end
+
+local function onPlayerAdded(player: Player)
+	if states[player] or player.Parent ~= Players then
+		return
+	end
+	local st = newState()
+	states[player] = st
+	setAttr(player, "VoiceOn", false) -- muted until the choice is known
+	table.insert(st.connections, player.ChildAdded:Connect(function(child)
+		if child:IsA("AudioDeviceInput") then
+			useDevice(player, st)
+		end
+	end))
+	table.insert(st.connections, player.ChildRemoved:Connect(function(child)
+		if child == st.device then
+			useDevice(player, st)
+		end
+	end))
+	table.insert(st.connections, player:GetAttributeChangedSignal("Alive"):Connect(queueRefresh))
+	for _, attribute in ipairs({ "SettingsJson", "SettingsLoaded" }) do
+		table.insert(st.connections, player:GetAttributeChangedSignal(attribute):Connect(function()
+			readSaved(player, st)
+			queueRefresh()
+		end))
+	end
+	readSaved(player, st)
+	useDevice(player, st)
+	queueRefresh()
+	task.spawn(checkEligibility, player, st)
+	if VoiceServers then
+		task.spawn(VoiceServers.onPlayerAdded, player)
+	end
+end
+
+local function onPlayerRemoving(player: Player)
+	local st = states[player]
+	if not st then
+		return
+	end
+	for _, connection in ipairs(st.connections) do
+		connection:Disconnect()
+	end
+	states[player] = nil
+	for _, other in pairs(states) do
+		other.allies[player] = nil
+	end
+	queueRefresh()
+end
+
+local function handleRequest(player: Player, st, action: string, value: any)
+	if action == "SetVoice" then
+		if type(value) ~= "boolean" then
+			return
+		end
+		st.explicit = value
+		if value == false then
+			st.pending.SetVoice = nil -- an older ON still waiting for its turn must not land after this OFF
+		end
+		safeRefresh()
+	elseif action == "Whisper" then
+		if type(value) ~= "boolean" then
+			return
+		end
+		st.whisper = value and (VoiceCfg.Whisper or {}).Enabled == true
+		safeRefresh()
+	elseif action == "JoinVoiceServer" or action == "LeaveVoiceServer" then
+		if VoiceServers then
+			task.spawn(VoiceServers.request, player, action)
+		end
+	end
+end
+
+local ACTIONS = { SetVoice = true, Whisper = true, JoinVoiceServer = true, LeaveVoiceServer = true }
+
+local function onRequest(player: Player, action: any, value: any)
+	local st = states[player]
+	if not st or type(action) ~= "string" or ACTIONS[action] ~= true then
+		return
+	end
+	if Routing.exempt(action, value) then
+		handleRequest(player, st, action, value) -- turning voice off is never limited or delayed
+		return
+	end
+	if Net.rateLimit(player, "Voice:" .. action, 4, 8) then
+		handleRequest(player, st, action, value)
+		return
+	end
+	-- over the limit: keep the latest of each action and apply it shortly, so the last request always lands
+	st.pending[action] = { value = value }
+	if st.flushQueued then
+		return
+	end
+	st.flushQueued = true
+	task.delay(FLUSH_DELAY, function()
+		st.flushQueued = false
+		if states[player] ~= st then
+			return
+		end
+		local pending = st.pending
+		st.pending = {}
+		for pendingAction, entry in pairs(pending) do
+			handleRequest(player, st, pendingAction, entry.value)
+		end
+	end)
+end
+
+-- Public API ---------------------------------------------------------------------------------------------------------
+
+function VoiceService.isEnabled(): boolean
+	return enabled
+end
+
+function VoiceService.getRole(player: Player): string
+	local st = states[player]
+	return if st then st.role else "Open"
+end
+
+function VoiceService.refresh()
+	if enabled then
+		safeRefresh()
+	end
+end
+
+-- PlayerService.handleDeath calls this right after the victim's Alive attribute goes false: they join the bench now,
+-- not a frame later, so not a word reaches the living from the body.
+function VoiceService.onEliminated(_player: Player)
+	if enabled then
+		safeRefresh()
+	end
+end
+
+-- For a future TruceService: the allies who may hear this player's whisper (Config.Voice.Whisper). An empty list ends it.
+function VoiceService.setAllies(player: Player, allies: { Player })
+	local st = states[player]
+	if not st then
+		return
+	end
+	table.clear(st.allies)
+	if type(allies) == "table" then
+		for _, ally in ipairs(allies) do
+			if typeof(ally) == "Instance" and ally:IsA("Player") and ally ~= player then
+				st.allies[ally] = true
+			end
+		end
+	end
+	if next(st.allies) == nil then
+		st.whisper = false
+	end
+	if enabled then
+		safeRefresh()
+	end
+end
+
+function VoiceService.debugState(): { [string]: any }
+	local players = {}
+	for player, st in pairs(states) do
+		local entry: { [string]: any } = {
+			name = player.Name,
+			role = st.role,
+			on = Routing.choice(st, VoiceCfg.DefaultOn ~= false),
+			explicit = st.explicit,
+			saved = st.saved,
+			loadState = st.loadState,
+			eligible = st.eligible,
+			device = st.device ~= nil,
+			failed = st.failed,
+		}
+		local device = st.device
+		if device then
+			pcall(function()
+				entry.muted = device.Muted
+				entry.micActive = device.Active
+				entry.accessType = tostring(device.AccessType)
+				entry.listSize = #device:GetUserIdAccessList()
+			end)
+		end
+		table.insert(players, entry)
+	end
+	return { enabled = enabled, mode = serverMode, roundRunning = roundRunning(), players = players }
+end
+
+-- Lifecycle ----------------------------------------------------------------------------------------------------------
+
+function VoiceService.Init(registry)
+	Services = registry
+	if VoiceCfg.Enabled ~= true then
+		return
+	end
+	if not (ALLOW and DENY) then
+		warnOnce("enum", "Enum.AccessModifierType is missing (no Audio API in this build?): Proximity Voice stays off.")
+		return
+	end
+	enabled = true
+	serverMode = if VoiceCfg.ServerMode == "Off" then "Off" else "Proximity"
+	GameState:SetAttribute("VoiceMode", serverMode)
+	Net.event("VoiceRequest").OnServerEvent:Connect(onRequest)
+
+	local serversCfg = VoiceCfg.VoiceServers or {}
+	local module = script:FindFirstChild("VoiceServers")
+	if serversCfg.Enabled == true and module and module:IsA("ModuleScript") then
+		local ok, result = pcall(require, module)
+		if ok and type(result) == "table" then
+			VoiceServers = result
+			result.init(VoiceService)
+		else
+			warn("[VoiceService] VoiceServers failed to load: " .. tostring(result))
+		end
+	end
+end
+
+function VoiceService.Start()
+	if not enabled then
+		return
+	end
+	GameState:GetAttributeChangedSignal("Phase"):Connect(queueRefresh)
+	Players.PlayerAdded:Connect(onPlayerAdded)
+	Players.PlayerRemoving:Connect(onPlayerRemoving)
+	for _, player in ipairs(Players:GetPlayers()) do
+		task.spawn(onPlayerAdded, player)
+	end
+	if VoiceServers then
+		task.spawn(function()
+			local ok, mode = pcall(VoiceServers.resolve) -- yields (MemoryStore); a public server returns nil at once
+			if ok and mode == "VoiceOnly" and serverMode ~= "Off" then
+				serverMode = "VoiceOnly"
+				GameState:SetAttribute("VoiceMode", "VoiceOnly")
+				queueRefresh()
+			elseif not ok then
+				warn("[VoiceService] VoiceServers.resolve failed: " .. tostring(mode))
+			end
+		end)
+	end
+	while true do
+		task.wait(SAFETY_INTERVAL)
+		-- the backstop: a missed device, a missed attribute change or a failed write is caught here
+		for player, st in pairs(states) do
+			if player.Parent == Players then
+				local ok = pcall(function()
+					readSaved(player, st)
+					local device = findDevice(player)
+					if device ~= st.device then
+						st.device = device
+						st.lastTarget = nil
+						st.failed = false
+					end
+				end)
+				if not ok then
+					st.failed = true
+				end
+			end
+		end
+		safeRefresh()
+	end
+end
+
+return VoiceService
diff --git a/src/ServerStorage/Dev/VoiceRoutingTest.lua b/src/ServerStorage/Dev/VoiceRoutingTest.lua
new file mode 100644
index 0000000000000000000000000000000000000000..8e64830f735891b1b39cb3b4e9b4f565a4352099
--- /dev/null
+++ b/src/ServerStorage/Dev/VoiceRoutingTest.lua
@@ -0,0 +1,206 @@
+--[[
+	VoiceRoutingTest - checks Proximity Voice's server rules (ServerScriptService.Server.Services.VoiceService.Routing)
+	in Edit mode, with no playtest, no voice and no second player (docs/design/VoiceMode.md, test plan S1).
+	Command bar (or execute_luau, Edit):
+	  print(require(game.ServerStorage.Dev.VoiceRoutingTest:Clone()).run())
+	-> "PASS 4416 checks (VoiceRoutingTest)" or "FAIL n of m" plus the first failures. Run it after installing the drafts
+	and after any change to Routing; it must PASS before the test publish.
+	What it proves: roles per phase; the living are never on the bench's list; a saved OFF never turns on by itself (a
+	slow or failed load stays muted, with no time limit); turning voice off is never rate-limited; and every write order
+	Routing.plan produces, from every device state to every target (4 players, 2,176 switches), ends in the target and
+	never lets anyone hear the player who isn't allowed to both before and after the switch.
+	What it can't prove: what Roblox's voice servers do with the lists (the published safety gate G1-G6 covers that).
+]]
+local ServerScriptService = game:GetService("ServerScriptService")
+
+local VoiceRoutingTest = {}
+
+local USERS = { 1, 2, 3, 4 }
+
+local function loadRouting(): any
+	local module = ServerScriptService:FindFirstChild("Server")
+	module = module and module:FindFirstChild("Services")
+	module = module and module:FindFirstChild("VoiceService")
+	module = module and module:FindFirstChild("Routing")
+	assert(module and module:IsA("ModuleScript"), "ServerScriptService.Server.Services.VoiceService.Routing is missing")
+	return require(module:Clone()) -- a fresh copy, so an edit made a moment ago counts
+end
+
+local function subsets(items: { number }): { { number } }
+	local out = {}
+	for mask = 0, 2 ^ #items - 1 do
+		local set = {}
+		for i, id in ipairs(items) do
+			if math.floor(mask / 2 ^ (i - 1)) % 2 == 1 then
+				table.insert(set, id)
+			end
+		end
+		table.insert(out, set)
+	end
+	return out
+end
+
+local function keys(set: { [number]: boolean }): string
+	local list = {}
+	for id in pairs(set) do
+		table.insert(list, id)
+	end
+	table.sort(list)
+	return "{" .. table.concat(list, ",") .. "}"
+end
+
+local function subsetOf(a: { [number]: boolean }, b: { [number]: boolean }): boolean
+	for id in pairs(a) do
+		if not b[id] then
+			return false
+		end
+	end
+	return true
+end
+
+local function intersect(a: { [number]: boolean }, b: { [number]: boolean }): { [number]: boolean }
+	local out = {}
+	for id in pairs(a) do
+		if b[id] then
+			out[id] = true
+		end
+	end
+	return out
+end
+
+local function describe(state: { [string]: any }): string
+	return string.format("%s/%s/{%s}", if state.muted then "muted" else "live", if state.allow then "Allow" else "Deny",
+		table.concat(state.list, ","))
+end
+
+-- A fake device: applies one planned write the way VoiceService.runSteps does
+local function applyStep(state: { [string]: any }, step: { [string]: any }): { [string]: any }
+	local nextState = { muted = state.muted, allow = state.allow, list = table.clone(state.list) }
+	if step.op == "Muted" then
+		nextState.muted = step.value == true
+	elseif step.op == "AccessType" then
+		nextState.allow = step.value == "Allow"
+	elseif step.op == "List" then
+		nextState.list = table.clone(step.value)
+		table.sort(nextState.list)
+	else
+		error("unknown op " .. tostring(step.op))
+	end
+	return nextState
+end
+
+function VoiceRoutingTest.run(): string
+	local Routing = loadRouting()
+	local passed, failed, notes = 0, 0, {}
+	local function check(ok: boolean, label: string)
+		if ok then
+			passed += 1
+		else
+			failed += 1
+			if #notes < 12 then
+				table.insert(notes, "  FAIL " .. label)
+			end
+		end
+	end
+
+	-- 1. Roles
+	check(Routing.role(false, true) == "Open", "no round: an alive player is Open")
+	check(Routing.role(false, false) == "Open", "no round: everyone is Open")
+	check(Routing.role(true, true) == "Contender", "round running: alive = Contender")
+	check(Routing.role(true, false) == "Bench", "round running: not alive = Bench")
+	local roster = {
+		{ key = "alive1", id = 11, alive = true },
+		{ key = "fallen", id = 12, alive = false },
+		{ key = "alive2", id = 13, alive = true },
+		{ key = "lateJoiner", id = 14, alive = false },
+	}
+	local roles, bench = Routing.assign(roster, true)
+	check(roles.alive1 == "Contender" and roles.alive2 == "Contender", "assign: the living are contenders")
+	check(roles.fallen == "Bench" and roles.lateJoiner == "Bench", "assign: the fallen and late joiners are on the bench")
+	check(#bench == 2 and bench[1] == 12 and bench[2] == 14, "assign: the bench list is exactly the bench, sorted")
+	for _, id in ipairs(bench) do
+		check(id ~= 11 and id ~= 13, "assign: no living contender is on the bench list")
+	end
+	local openRoles, openBench = Routing.assign(roster, false)
+	check(openRoles.fallen == "Open" and #openBench == 0, "assign: no round running: nobody on the bench")
+
+	-- 2. The choice: a saved OFF never turns on by itself
+	check(Routing.choice({ loadState = "Loading" }, true) == nil, "choice: still loading = unknown (muted), however long")
+	check(Routing.choice({ loadState = "Failed" }, true) == nil, "choice: the load failed = unknown (muted)")
+	check(Routing.choice({ loadState = "Loaded", saved = false }, true) == false, "choice: saved OFF stays OFF")
+	check(Routing.choice({ loadState = "Loaded", saved = true }, false) == true, "choice: saved ON stays ON")
+	check(Routing.choice({ loadState = "Loaded" }, true) == true, "choice: loaded, never chosen = DefaultOn (true)")
+	check(Routing.choice({ loadState = "Loaded" }, false) == false, "choice: loaded, never chosen = DefaultOn (false)")
+	check(Routing.choice({ loadState = "Failed", explicit = true }, false) == true, "choice: an explicit ON wins")
+	check(Routing.choice({ loadState = "Loaded", saved = true, explicit = false }, true) == false, "choice: an explicit OFF wins")
+
+	-- 3. Desired device states
+	local bench3 = { 2, 3 }
+	local d = Routing.desired("Bench", true, false, {}, bench3, "Proximity")
+	check(d.allow == true and not d.muted and #d.list == 2 and d.list[1] == 2 and d.list[2] == 3, "desired: bench = Allow + the bench")
+	d.list[1] = 99
+	check(bench3[1] == 2, "desired: the bench list is copied, not shared")
+	d = Routing.desired("Contender", true, false, {}, bench3, "Proximity")
+	check(d.allow == false and #d.list == 0 and not d.muted, "desired: contender = Deny + empty (anyone in range)")
+	d = Routing.desired("Contender", true, true, { 4 }, bench3, "Proximity")
+	check(d.allow == true and #d.list == 1 and d.list[1] == 4, "desired: whisper = Allow + allies only")
+	d = Routing.desired("Contender", true, true, {}, bench3, "Proximity")
+	check(d.allow == false, "desired: whisper with no allies = normal voice")
+	d = Routing.desired("Open", true, false, {}, bench3, "Proximity")
+	check(d.allow == false and #d.list == 0 and not d.muted, "desired: open = Deny + empty")
+	check(Routing.desired("Open", nil, false, {}, bench3, "Proximity").muted == true, "desired: unknown choice = muted")
+	check(Routing.desired("Open", false, false, {}, bench3, "Proximity").muted == true, "desired: OFF = muted")
+	check(Routing.desired("Bench", true, false, {}, bench3, "Off").muted == true, "desired: ServerMode Off = muted")
+
+	-- 4. Requests: turning voice off is never rate-limited or dropped
+	check(Routing.exempt("SetVoice", false) == true, "exempt: SetVoice(false)")
+	check(Routing.exempt("SetVoice", true) == false, "exempt: not SetVoice(true)")
+	check(Routing.exempt("Whisper", true) == false and Routing.exempt("Whisper", false) == false, "exempt: not Whisper")
+
+	-- 5. Every write order, from every device state to every target the rules can produce
+	local states = {}
+	for _, muted in ipairs({ false, true }) do
+		for _, allow in ipairs({ false, true }) do
+			for _, list in ipairs(subsets(USERS)) do
+				table.insert(states, { muted = muted, allow = allow, list = list })
+			end
+		end
+	end
+	local targets = {}
+	for _, muted in ipairs({ false, true }) do
+		for _, list in ipairs(subsets(USERS)) do
+			table.insert(targets, { muted = muted, allow = true, list = list })
+		end
+		table.insert(targets, { muted = muted, allow = false, list = {} })
+	end
+	for _, current in ipairs(states) do
+		for _, target in ipairs(targets) do
+			local steps = Routing.plan(current, target)
+			local label = describe(current) .. " -> " .. describe(target)
+			local allowed = intersect(Routing.audience(current, USERS), Routing.audience(target, USERS))
+			local s = current
+			local leaked = nil
+			for i, step in ipairs(steps) do
+				s = applyStep(s, step)
+				if i < #steps and not subsetOf(Routing.audience(s, USERS), allowed) then
+					leaked = string.format("step %d of %d lets %s hear", i, #steps, keys(Routing.audience(s, USERS)))
+					break
+				end
+			end
+			check(leaked == nil, label .. ": " .. tostring(leaked))
+			check(s.muted == target.muted and s.allow == target.allow and Routing.sameList(s.list, target.list),
+				label .. ": ends in " .. describe(s))
+			if current.muted == target.muted and current.allow == target.allow and Routing.sameList(current.list, target.list) then
+				check(#steps == 0, label .. ": no writes when nothing changes")
+			end
+		end
+	end
+
+	local total = passed + failed
+	if failed == 0 then
+		return string.format("PASS %d checks (VoiceRoutingTest)", total)
+	end
+	return string.format("FAIL %d of %d checks (VoiceRoutingTest)\n%s", failed, total, table.concat(notes, "\n"))
+end
+
+return VoiceRoutingTest
