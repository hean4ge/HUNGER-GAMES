# Python and Blender leftovers
__pycache__/
*.pyc
*.blend1
*.blend@

# Art previews: keep the art director's renders, the Studio look-check shots and each set's lineup image.
# Everything else is a render output; regenerate it with the review scripts in art/blender (see art/README.md).
art/previews/**/tiles/
art/previews/_ArtDirection/_sheet_*
art/previews/Arms/*
art/previews/Buildings/*
art/previews/Foliage/*
art/previews/Items/*
art/previews/Landmarks/*
art/previews/Props/*
art/previews/Rocks/*
art/previews/BuildingsReal/*
art/previews/GroundReal/*
art/previews/ItemsReal/*
art/previews/LandmarksReal/*
art/previews/TreesReal/*
!art/previews/*/_lineup*.png

# Style test: keep the comparison sheet and one lineup per style; the rest regenerates from
# art/blender/style_*.py (Blender renders) or the Workspace.StyleTest diorama (Studio captures).
art/previews/StyleTest/A/*
art/previews/StyleTest/B/*
art/previews/StyleTest/C/*
art/previews/StyleTest/Studio/*
!art/previews/StyleTest/A/A_lineup_midday.png
!art/previews/StyleTest/B/_B_overview.png
!art/previews/StyleTest/C/lineup_midday.png

# Train set (art/blender/train_sotr.py): the compare sheets put film frames beside our renders for review. Film
# imagery never goes into the repo (docs/design/UpcomingFilm_Brief.md), so they stay local; the renders are kept.
art/previews/Train/compare_*

# Map 1, Map 2, the launch rooms and the train (arenas v5, 2026-11-14): keep the renders the design docs link to and the
# colour checks; every other render regenerates from art/blender/{map1_green_land,map2_clock_arena,launch_rooms,
# train_sotr}.py. The compare sheets hold film frames and are never committed (see the per-set .gitignore files).
art/previews/Map1/*
art/previews/Map2/*
art/previews/Launch/*
art/previews/Train/*
!art/previews/Map1/overview_aerial.png
!art/previews/Map2/overview_high_aerial.png
!art/previews/Map2/sector_reads.png
!art/previews/Map2/tones.json
!art/previews/Launch/rise_path_sheet.png
!art/previews/Launch/palette_swatches.png
!art/previews/Launch/colour_check.json
!art/previews/Train/exterior_night_bridge.png
!art/previews/Train/tones_palette.png
!art/previews/*/.gitignore

# studio_sync local state (fingerprints of what Studio last had)
.studio_sync/
